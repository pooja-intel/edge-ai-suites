dbrp "datain"."autogen"

var data0 = stream
        |from()
                .database('datain')
                .retentionPolicy('autogen')
                .measurement('wind-turbine-data')
                .groupBy('source')
        |window()
                .period(1m)
                .every(1m)
        @windturbine_anomaly_detector()
data0
        |influxDBOut()
                .buffer(0)
                .database('datain')
                .measurement('wind-turbine-anomaly-data')
                .retentionPolicy('autogen')
